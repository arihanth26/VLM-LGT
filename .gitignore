# Python
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Downloaded and generated dataset files (large, regenerate via download.py / preprocess.py)
**/raw/*
!**/raw/.gitkeep
**/processed/*
!**/processed/.gitkeep
**/failure_pool/*
!**/failure_pool/.gitkeep
**/results/*
!**/results/.gitkeep
**/q_features/*
!**/q_features/.gitkeep
**/q_models/*
!**/q_models/.gitkeep

# Model checkpoints and local weights
*.pt
*.bin
*.safetensors

# Slurm job output
logs/*.out
!logs/.gitkeep

# OS / editor
.DS_Store
.vscode/

# Local caches on the cluster
.hf_cache/
.pip_cache/
